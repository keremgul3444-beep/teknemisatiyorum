{
  "name": "@tms/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run build -w @tms/shared && tsc -p tsconfig.json",
    "dev": "npm run build && npm run start",
    "start": "node --env-file=.env dist/src/main.js",
    "db": "tsx scripts/db.ts",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "prisma": "prisma",
    "lint": "expo lint"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "embedded-postgres": "^17.10.0-beta.17",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
