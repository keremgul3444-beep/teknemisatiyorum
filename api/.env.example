# Kopyala: cp .env.example .env  — .env git'e girmez.
# Ortam: development | production (zorunlu). scripts/dev.mjs yerel .env'i development olarak üretir.
NODE_ENV=production
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/postgres
# En az 32 karakter rastgele: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# 32 bayt base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ID_ENC_KEY=
# console.anthropic.com > API Keys. Boşsa asistan kural tabanlı ayrıştırıcıyla çalışır.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
# Kapalı beta: SMS bağlanana kadar giriş kodu uygulamada gösterilir (üretimde etkisiz).
DEV_OTP_ECHO=0
# IP başına saatlik giriş kodu sınırı (üretimde 10; yerel testte hepsi aynı IP'den geldiği için yükseltilir).
OTP_IP_LIMIT=10
CORS_ORIGINS=http://localhost:8081
PUBLIC_URL=
# Ödemeler: dev = deneme (para çekilmez, üretimde başlamaz), live = gerçek sağlayıcı (Aşama 2), off = ödeme kapalı.
PAYMENTS_MODE=dev
# Ödeme bildirimi imza anahtarı, en az 32 karakter: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET=
# Sitenin adresi (ödeme dönüşü ve deneme ödeme sayfası).
WEB_URL=http://localhost:3001
# Yalnızca bu ara katmandan gelen X-Forwarded-For'a güvenilir (site ve geliştirme proxy'si aynı makinede).
TRUST_PROXY=loopback
# Dosya depolama: local = sunucu diski (STORAGE_DIR), s3 = S3 uyumlu bulut (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
STORAGE_DRIVER=local
STORAGE_DIR=storage
# STORAGE_DRIVER=s3 için (Cloudflare R2 örneği: https://<hesap>.r2.cloudflarestorage.com, bölge auto).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 1: günlük veritabanı yedeği şifrelenip buluta da yazılır (30 gün). Açmak: scripts/backup-decrypt.ts, aynı ID_ENC_KEY gerekir.
BACKUP_OFFSITE=0
# Kimlik doğrulama: algorithm = yalnızca numara algoritması (geliştirme), nvi = NVİ KPSPublic sorgusu (canlıda kullan).
IDENTITY_MODE=algorithm
# SMS (giriş kodu): dev = konsola yazar (üretimde başlamaz), netgsm, twilio.
SMS_MODE=dev
# netgsm: abone no / API şifresi / onaylı başlık. twilio: Account SID / Auth Token / gönderen numara.
SMS_USER=
SMS_PASSWORD=
SMS_SENDER_NAME=
# Seed'in oluşturduğu yönetici hesabının telefonu (+905XXXXXXXXX).
SEED_ADMIN_PHONE=+905000000000
# Usta ve kaptan ödemelerinde ödeyenden alınan platform payı (yüzde).
SERVICE_FEE_PERCENT=8
