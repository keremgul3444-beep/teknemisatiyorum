# Kopyala: cp .env.example .env.local — .env.local git'e girmez.
# API'nin adresi (site sunucusu buradan veri alır; tarayıcı API'yi doğrudan görmez).
API_URL=http://127.0.0.1:3000
# Sitenin herkese açık adresi (canonical, site haritası, paylaşım kartları).
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Uygulamanın derin bağlantı şeması (app.json "scheme").
NEXT_PUBLIC_APP_SCHEME=teknemisatiyorum
