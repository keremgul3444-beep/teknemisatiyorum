# Canlı ortam ayarları — bu dosyanın kopyası (deploy/.env) yalnızca sunucuda durur, git'e girmez.
# Rastgele değer üretmek: openssl rand -base64 48   (ID_ENC_KEY için: openssl rand -base64 32)

# Alan adı (DNS'te A kaydı sunucunun IP'sine; api.<alan adı> da aynı IP'ye)
DOMAIN=teknemisatiyorum.com
DB_PASSWORD=

NODE_ENV=production
JWT_SECRET=
# 32 bayt base64. KAYBETME: kimlik numaraları ve buluttaki yedekler bu anahtarla şifreli.
ID_ENC_KEY=
PAYMENT_WEBHOOK_SECRET=
# Yöneticinin (senin) cep telefonu: giriş kodu bu numaraya gelir.
SEED_ADMIN_PHONE=+905
SEED_DEMO=0

# Kimlik doğrulama: canlıda NVİ
IDENTITY_MODE=nvi
# Ödemeler: off = kapalı (ilan ve hizmetler çalışır, ödeme butonları hata verir).
# Lisanslı ödeme kuruluşu / sanal POS anlaşması bağlanınca live yapılır. dev üretimde reddedilir.
PAYMENTS_MODE=off
SERVICE_FEE_PERCENT=8
# SMS (giriş kodu): netgsm veya twilio. dev üretimde reddedilir.
# netgsm: SMS_USER = abone no (850...), SMS_PASSWORD = API alt kullanıcı şifresi, SMS_SENDER_NAME = onaylı başlık.
# twilio: SMS_USER = Account SID, SMS_PASSWORD = Auth Token, SMS_SENDER_NAME = gönderen numara (+1...).
SMS_MODE=netgsm
SMS_USER=
SMS_PASSWORD=
SMS_SENDER_NAME=
# Anlık bildirim (Expo)
PUSH_MODE=expo
# Akıllı asistan (boşsa kural tabanlı)
ANTHROPIC_API_KEY=

# Dosyalar ve yedek: bulut (Cloudflare R2 önerilir)
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
BACKUP_OFFSITE=1
