# Site: alan adı (ve www → yönlendirme). API: api.<alan adı> (uygulama buraya bağlanır).
# Caddy sertifikaları Let's Encrypt'ten kendisi alır ve yeniler.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3001
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

api.{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 12MB
	}
	reverse_proxy api:3000
}
