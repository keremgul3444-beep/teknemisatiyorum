{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.teknemisatiyorum.com",
        "EXPO_PUBLIC_WEB_URL": "https://teknemisatiyorum.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.teknemisatiyorum.com",
        "EXPO_PUBLIC_WEB_URL": "https://teknemisatiyorum.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
